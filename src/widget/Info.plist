<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Il widget di iPhone, un'estensione WidgetKit dentro l'app, in PlugIns/.
	     Versione, build, chiavi DT* e MinimumOSVersion li copia
	     widget-linux.sh da src/ios/Info.plist: l'estensione esce dentro l'app
	     e deve dire gli stessi numeri. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>OpenCard</string>
	<key>CFBundleExecutable</key>
	<string>OpenCardWidget</string>
	<key>CFBundleIdentifier</key>
	<string>srl.denovo.opencard.widget</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>OpenCardWidget</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>0</string>
	<key>CFBundleVersion</key>
	<string>0</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<!-- App Store Connect lo pretende per ogni binario a 64 bit (ITMS-90502,
	     29 ottobre 2026): senza, la consegna della 2026102901 e' stata rifiutata. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.widgetkit-extension</string>
	</dict>
</dict>
</plist>
