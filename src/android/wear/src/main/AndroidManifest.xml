<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Niente backup di sistema: le carte le rimanda il telefono. Il file
         resta cifrato con la chiave di questo orologio, come sul telefono.
         allowBackup vale fino ad Android 11, le regole in xml da Android 12:
         dicono la stessa cosa. -->
    <application
        android:name=".Applicazione"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library android:name="com.google.android.wearable" android:required="true" />

        <!-- Non è autonoma: senza l'app sul telefono non ha carte da mostrare,
             e Play la propone solo a chi ha il telefono con OpenCard. -->
        <meta-data android:name="com.google.android.wearable.standalone" android:value="false" />

        <!-- Le due schermate sono un compito solo, con lo stesso taskAffinity:
             è quello che Wear OS chiede perché l'app compaia una volta sola
             fra le app recenti. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="srl.denovo.opencard.orologio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CodiceActivity"
            android:exported="false"
            android:taskAffinity="srl.denovo.opencard.orologio" />

        <!-- Le carte dal telefono. Lo avvia Google Play services quando arriva
             il messaggio, anche con l'app chiusa, e per questo è esportato. -->
        <service android:name=".DalTelefono" android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/opencard" />
            </intent-filter>
        </service>
    </application>
</manifest>
