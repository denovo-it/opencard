<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- L'app non ha niente da mandare da nessuna parte, e la scheda dello store
         lo dice. Queste due arrivano dal merge del manifest, non da qui: le
         aggiunge com.google.android.datatransport:transport-backend-cct, che è
         il pezzo con cui ML Kit manda la telemetria a Google. Il modello di
         lettura sta dentro l'app e la scansione è offline, quindi togliendole
         non manca niente all'utente. Chi apre le autorizzazioni su Play non
         legge più "accesso completo a Internet". -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- allowBackup="false": le carte non vanno nel backup automatico verso il
         cloud di Google. Su iPhone la scelta è l'opposta, il file rientra nel
         backup di iCloud, e la privacy policy su denovo.srl dichiara tutte e
         due le cose. Chi cambia telefono Android porta le carte con il backup
         su file o con il passaggio a QR. -->
    <application
        android:name=".Applicazione"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema.OpenCard">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" />

        <activity android:name=".DettaglioActivity" android:parentActivityName=".MainActivity" />
        <activity android:name=".FormActivity" android:parentActivityName=".MainActivity" />
        <activity android:name=".ScannerActivity" android:parentActivityName=".FormActivity" />
        <activity android:name=".TrasferimentoActivity" android:parentActivityName=".MainActivity" />
        <activity android:name=".InfoActivity" android:parentActivityName=".MainActivity" />
    </application>
</manifest>
