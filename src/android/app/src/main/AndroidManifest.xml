<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- L'app non ha niente da mandare da nessuna parte, e la scheda dello store
         lo dice. Queste due arrivano dal merge del manifest, non da qui: le
         aggiunge com.google.android.datatransport:transport-backend-cct, che è
         il pezzo con cui ML Kit manda la telemetria a Google. Il modello di
         lettura sta dentro l'app e la scansione è offline, quindi togliendole
         non manca niente all'utente. Chi apre le autorizzazioni su Play non
         legge più "accesso completo a Internet". -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Il backup verso il cloud di Google lo decide chi usa l'app, da
         Impostazioni, e di partenza è spento. Cosa esce lo stabilisce
         BackupNelCloud, non queste righe: senza interruttore acceso il sistema
         chiama l'agente e l'agente non gli dà niente. fullBackupOnly perché il
         backup a chiave e valore qui non serve. Su iPhone la scelta di
         partenza è l'opposta, e la privacy policy su denovo.srl dichiara tutte
         e due le cose. -->
    <application
        android:name=".Applicazione"
        android:allowBackup="true"
        android:backupAgent=".BackupNelCloud"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Tema.OpenCard"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" />

        <!-- La foto a schermo pieno: si apre dalla schermata della carta. -->
        <activity android:name=".FotoActivity" android:exported="false" android:parentActivityName=".DettaglioActivity" />

        <activity android:name=".DettaglioActivity" android:parentActivityName=".MainActivity" />
        <activity android:name=".FormActivity" android:parentActivityName=".MainActivity" />
        <activity android:name=".ScannerActivity" android:parentActivityName=".FormActivity" />
        <activity android:name=".TrasferimentoActivity" android:parentActivityName=".MainActivity" />
        <activity android:name=".InfoActivity" android:parentActivityName=".MainActivity" />
        <activity android:name=".ImpostazioniActivity" android:parentActivityName=".MainActivity" />

        <!-- Prima di Android 13 la lingua scelta la ricorda AppCompat, e per
             ricordarla vuole questo servizio dichiarato. Non gira mai: e'
             solo il posto dove sta scritto "autoStoreLocales". -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>
</manifest>
