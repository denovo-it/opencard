<?xml version="1.0" encoding="utf-8"?>
<!-- Il fondo del widget: bianco, e il colore della carta ci arriva a runtime
     con setColorFilter. Serve un disegno e non uno sfondo di colore, perche'
     setBackgroundColor cancellerebbe gli angoli arrotondati. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/white" />
    <corners android:radius="20dp" />
</shape>
