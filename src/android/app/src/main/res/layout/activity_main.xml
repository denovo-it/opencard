<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand"
        app:elevation="0dp">

        <!-- Il marchio prende il posto della scritta "OpenCard": a 30dp risultava
             schiacciato, quindi la barra è più alta per contenerlo. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/Barra.OpenCard"
            android:layout_width="match_parent"
            android:layout_height="68dp">

            <!-- Il logo da solo, centrato nella barra: senza la pastiglia del
                 canale accanto non serve più il contenitore orizzontale, che
                 spostava il marchio a sinistra per fare posto alla scritta. -->
            <ImageView
                android:id="@+id/marca"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/opencard_appbar" />
        </com.google.android.material.appbar.MaterialToolbar>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/schede"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/brand"
            app:tabIndicatorColor="@color/on_brand"
            app:tabSelectedTextColor="@color/on_brand"
            app:tabTextColor="#CCFFFFFF">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scheda_carte" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scheda_usa_e_getta" />
        </com.google.android.material.tabs.TabLayout>

        <!-- La ricerca per etichetta vale per tutte le schede insieme: sta
             sopra le pagine e non dentro, così non si perde cambiando scheda.
             Il fondo è quello della lista, non l'arancione della barra. -->
        <FrameLayout
            android:id="@+id/ricerca_riquadro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:colorBackground"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:visibility="gone">

            <!-- La X è messa a mano e non con endIconMode="clear_text", che la
                 mostra solo col fuoco nel campo: chiusa la tastiera sparirebbe
                 mentre il filtro è ancora acceso.
                 Fondo pieno, angoli a 16dp e niente bordo come le carte sotto;
                 il suggerimento sta nel campo e non sale sul bordo. -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ricerca_contenitore"
                style="@style/Widget.Material3.TextInputLayout.FilledBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintEnabled="false"
                app:endIconContentDescription="@string/cancella_ricerca"
                app:endIconDrawable="@drawable/ic_chiudi"
                app:endIconMode="custom"
                app:startIconDrawable="@drawable/ic_cerca">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ricerca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/cerca_etichetta"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Due pagine affiancate: si passa da una scheda all'altra anche
         scorrendo con il dito, non solo toccando la scheda. -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pagine"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Centrato e staccato dal fondo: sul bordo finiva contro i tasti virtuali. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/aggiungi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:contentDescription="@string/aggiungi"
        app:backgroundTint="@color/brand"
        app:srcCompat="@drawable/ic_aggiungi"
        app:tint="@color/on_brand" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
