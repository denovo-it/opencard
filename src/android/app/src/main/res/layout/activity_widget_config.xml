<?xml version="1.0" encoding="utf-8"?>
<!-- La radice è la stessa delle altre schermate. Con targetSdk 36, da Android 15
     la finestra passa sotto le barre di sistema, e senza fitsSystemWindows il
     titolo va sotto l'orologio e il fondo dell'elenco sotto la barra di
     navigazione. L'arancione sotto la barra di stato lo disegna la radice, con
     lo stile che le dà il tema. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_scegli"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vuoto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/nessuna_carta"
            android:textColor="@color/muted"
            android:visibility="gone" />

        <ListView
            android:id="@+id/elenco"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1" />
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
