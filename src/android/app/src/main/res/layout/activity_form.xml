<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/brand"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/barra"
            style="@style/Barra.OpenCard"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleCentered="true" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Annulla e Salva in alto: sugli schermi piccoli, in fondo
                 finivano sotto la tastiera quando un campo aveva il fuoco. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/annulla"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/annulla" />

                <Button
                    android:id="@+id/salva"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/salva" />
            </LinearLayout>

            <!-- Il messaggio sta qui e non in fondo: Salva e' in cima, e chi lo
                 preme deve leggere subito perche' non e' successo niente. In
                 fondo alla schermata restava fuori dallo schermo. Da vuoto e'
                 gone, cosi' non lascia un buco fra i pulsanti e l'etichetta. -->
            <TextView
                android:id="@+id/errore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/etichetta">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="120" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/codice">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/codice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:inputType="text"
                    android:maxLength="500" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/tipo_di_codice"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <!-- Dalla 1.0.3 le simbologie sono diciotto e non due: un elenco a
                 tendina al posto dei due bottoni. L'elenco parte da Automatico
                 e si cambia solo se serve, anche su una carta gia' salvata.
                 Scegliendone una che non contiene il codice l'avviso arriva
                 subito, senza aspettare Salva. -->
            <Spinner
                android:id="@+id/simbologia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <!-- I tre modi di prendere il codice, stesso peso e stessa riga:
                 dal vivo, da una foto della galleria, da un file. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <include
                    android:id="@+id/da_fotocamera"
                    layout="@layout/bottone_acquisizione"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/da_galleria"
                    layout="@layout/bottone_acquisizione"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/da_file"
                    layout="@layout/bottone_acquisizione"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/colore"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tavolozza"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp" />
            </HorizontalScrollView>

            <!-- I tre campi della 1.0.3. Restano vuoti finché non servono: la
                 nota si allarga fino a quattro righe, la scadenza vuole la
                 data scritta come aaaa-mm-gg, il saldo è testo libero perché
                 c'è chi conta punti e chi conta euro. -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/nota">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/nota"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="500"
                    android:maxLines="4" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:id="@+id/riquadro_scadenza"
                android:hint="@string/scadenza"
                app:endIconContentDescription="@string/annulla"
                app:endIconDrawable="@drawable/ic_chiudi"
                app:endIconMode="custom">

                <!-- Non si scrive a mano: si tocca e si apre il calendario, cosi'
                     la data e' sempre nel formato che il core accetta. La X in
                     fondo la svuota. -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/scadenza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:inputType="none"
                    android:longClickable="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/saldo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/saldo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLength="30" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Le due foto della carta. Il riquadro si tocca per sceglierne
                 una, la X la toglie. Vuote non si vedono: restano due bottoni
                 piatti con il nome del lato. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/foto_fronte"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/foto_fronte" />

                    <ImageView
                        android:id="@+id/anteprima_fronte"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="4dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/foto_fronte"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/foto_retro"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/foto_retro" />

                    <ImageView
                        android:id="@+id/anteprima_retro"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="4dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/foto_retro"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/usa_e_getta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/usa_e_getta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/usa_e_getta_spiega"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <!-- La stella si accende anche da qui, oltre che dalla carta
                 aperta: chi sta già modificando non deve uscire e rientrare. -->
            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/preferita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preferita" />

            <!-- In fondo e staccato da Salva: si vede solo modificando una carta
                 che esiste già, e chiede conferma prima di cancellare. Rosso in
                 tutte le sue parti, contorno, scritta, cestino e tocco: col
                 colore di serie prenderebbe l'arancione del marchio, che qui
                 direbbe la cosa sbagliata. -->
            <Button
                android:id="@+id/elimina"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/elimina"
                android:textColor="@color/danger"
                android:visibility="gone"
                app:icon="@drawable/ic_cestino"
                app:iconTint="@color/danger"
                app:rippleColor="@color/danger"
                app:strokeColor="@color/danger" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
