<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Manifesto della privacy. Apple lo pretende da maggio 2024 quando l'app
	     usa una delle API a motivazione obbligatoria: senza, il caricamento su
	     App Store Connect risponde ITMS-91053, «Missing API declaration».

	     Va nella radice del bundle, accanto a Info.plist, ed è un file di
	     testo: viene copiato nel bundle a ogni compilazione. -->

	<!-- Niente tracciamento e nessun dato raccolto: l'app non ha il permesso di
	     rete, non ha SDK di terze parti che parlano fuori, e le carte restano
	     nel container. E' la stessa cosa che dice la privacy policy su
	     denovo.srl e il modulo Data safety su Play. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- L'unica API a motivazione obbligatoria che tocchiamo: systemUptime,
		     in OCScannerViewController.m. Serve a misurare quanto tempo passa
		     fra due letture uguali del codice, cioè a decidere quando una
		     lettura è confermata. Motivazione 35F9.1: misurare il tempo
		     trascorso fra eventi avvenuti dentro l'app.

		     Nel resto del codice non c'è altro: niente NSUserDefaults, niente
		     date dei file, niente spazio su disco, niente sysctl. Se un giorno
		     entra una di quelle, va aggiunta qui. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
