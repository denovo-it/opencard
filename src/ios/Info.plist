<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>it_IT</string>
	<key>CFBundleDisplayName</key>
	<string>OpenCard</string>
	<key>CFBundleExecutable</key>
	<string>OpenCard</string>
	<key>CFBundleIdentifier</key>
	<string>srl.denovo.opencard</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>OpenCard</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.2</string>
	<key>CFBundleVersion</key>
	<string>2026082401</string>
	<!-- Nessuna crittografia: l'app non chiama niente di cifrato e non ha rete.
	     Senza questa chiave App Store Connect ripete la domanda sulla conformita'
	     all'esportazione a ogni caricamento. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>iPhoneOS</string>
	</array>
	<!-- Con quale SDK è stato costruito il bundle. App Store Connect legge
	     queste chiavi e senza risponde ITMS-90562, «Invalid Bundle». Devono
	     corrispondere all'SDK con cui si compila: quando l'SDK cambia, vanno
	     aggiornate. -->
	<key>DTPlatformName</key>
	<string>iphoneos</string>
	<key>DTPlatformVersion</key>
	<string>26.5</string>
	<key>DTPlatformBuild</key>
	<string>23F81a</string>
	<key>DTSDKName</key>
	<string>iphoneos26.5</string>
	<key>DTSDKBuild</key>
	<string>23F81a</string>
	<key>DTXcode</key>
	<string>2660</string>
	<key>DTXcodeBuild</key>
	<string>17F113</string>
	<key>DTCompiler</key>
	<string>com.apple.compilers.llvm.clang.1_0</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>13.0</string>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Le ragioni per cui l'app chiede: le legge l'utente nel dialogo di
	     sistema, quindi devono dire davvero a cosa serve il permesso. -->
	<key>NSCameraUsageDescription</key>
	<string>La fotocamera serve a leggere il codice della tessera, così non devi batterlo a mano.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Serve a leggere il codice da una foto della tessera che hai già scattato.</string>

	<!-- Icone. Le tre png sciolte restano: sono quelle che il telefono usa
	     quando si compila con le immagini segnaposto, ed è come l'app ha
	     girato fino alla 1.0.1. -->
	<key>CFBundleIconFiles</key>
	<array>
		<string>AppIcon60</string>
		<string>AppIcon120</string>
		<string>AppIcon180</string>
	</array>

	<!-- Per lo store non bastano. Il caricamento pretende un asset catalog
	     compilato con dentro l'icona 1024 (altrimenti ITMS-90704) e la chiave
	     CFBundleIconName (altrimenti ITMS-90713). L'asset catalog è il file
	     Assets.car che sta nel bundle accanto ad AppIcon60x60@2x.png. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60</string>
			</array>
			<key>CFBundleIconName</key>
			<string>AppIcon</string>
		</dict>
	</dict>
</dict>
</plist>
